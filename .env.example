# .env.example: generated by scripts/env-inventory.mjs from the variables the code reads.
# Do not edit by hand; run `node scripts/env-inventory.mjs`. All values are empty on purpose.
#
# NEXT_PUBLIC_* variables are compiled into the browser bundle and are PUBLIC. Never put a
# secret in one. Server variables marked "Secret" are set only in the hosting provider.

# ─── Aztec and private payments (operator-critical) ─────────────────────────

# Read in: lib/aztec/client.ts
AZTEC_FPC_ADDRESS=

# "off" disables the server relay to the Aztec node.
# Read in: app/api/aztec/node/route.ts
AZTEC_NODE_RELAY=

# Read in: app/api/admin/launch-checklist/route.ts, app/api/aztec/account/route.ts, app/api/aztec/deploy/route.ts (+6 more)
AZTEC_NODE_URL=

# Read in: app/api/aztec/deploy-token/route.ts, app/api/aztec/deploy/route.ts, app/api/dev/testpxe/route.ts
AZTEC_PXE_URL=

# Secret. Server only.
# Read in: app/api/aztec/deploy-token/route.ts, app/api/dev/deploy/route.ts
AZTEC_RELAYER_SECRET_KEY=

# Sponsored transactions per day for everyone (default 200).
# Read in: lib/aztec/sponsor-voucher.ts
AZTEC_SPONSOR_PER_DAY=

# Sponsored transactions per wallet, for life (default 3).
# Read in: lib/aztec/sponsor-voucher.ts
AZTEC_SPONSOR_PER_WALLET=

# Secret. Server only.
# Read in: lib/aztec/sponsor-voucher.ts
AZTEC_SPONSOR_SIGNER_KEY=

# Secret. Server only.
# Read in: app/api/admin/launch-checklist/route.ts, app/api/aztec/deploy-token/route.ts, app/api/aztec/deploy/route.ts (+1 more)
AZTEC_TOKEN_CONTRACT_ADDRESS=

# "exits-only" stops new value without a deploy (read at every value action). Empty or "open": normal.
# Read in: app/api/aztec/value-mode/route.ts
AZTEC_VALUE_MODE=

# Per-token caps for payments and agreements on Alpha, in base units. A token without a cap is refused.
# Read in: lib/aztec/wallet/config.ts
NEXT_PUBLIC_AZTEC_AGREEMENT_CAPS=

# Must be "true" together with NEXT_PUBLIC_AZTEC_NETWORK=alpha, or the wallet refuses a node that settles on Ethereum mainnet.
# Read in: lib/aztec/wallet/config.ts
NEXT_PUBLIC_AZTEC_ALPHA_ENABLED=

# Explorer base URL for transaction links. No default on Alpha.
# Read in: lib/aztec/wallet/config.ts
NEXT_PUBLIC_AZTEC_EXPLORER=

# Read in: lib/aztec/wallet/config.ts
NEXT_PUBLIC_AZTEC_FAUCET=

# L1 chain the build expects (1 on Alpha). Checked against the node.
# Read in: lib/aztec/wallet/config.ts
NEXT_PUBLIC_AZTEC_L1_CHAIN_ID=

# L1 block where Fee Juice claim recovery starts scanning.
# Read in: lib/aztec/wallet/config.ts
NEXT_PUBLIC_AZTEC_L1_FROM_BLOCK=

# Aztec network of this build: "alpha" (Aztec Alpha, Ethereum mainnet, real funds) or empty for the test network. Read at build time.
# Read in: lib/aztec/wallet/config.ts, lib/features/zk.ts, lib/protocol/read.ts
NEXT_PUBLIC_AZTEC_NETWORK=

# Read in: lib/aztec/wallet/node-fetch.ts
NEXT_PUBLIC_AZTEC_NODE_RELAY=

# Aztec node JSON-RPC. Defaults to the pinned public node of the network.
# Read in: lib/aztec/wallet/config.ts, lib/zk/zkMoney.ts
NEXT_PUBLIC_AZTEC_NODE_URL=

# Read in: context/AztecContext.tsx
NEXT_PUBLIC_AZTEC_PXE_URL=

# Read in: lib/aztec/wallet/config.ts
NEXT_PUBLIC_AZTEC_RPC_MAX_BATCH=

# Read in: components/zk/ZkSequencerDashboard.tsx
NEXT_PUBLIC_AZTEC_RPC_URL=

# Address of the LedgerSponsor contract. Empty: sponsored fees are off. Set only after the deployment is recorded.
# Read in: app/api/aztec/sponsor/route.ts, lib/aztec/wallet/ledger-sponsor.ts, lib/protocol/read.ts
NEXT_PUBLIC_AZTEC_SPONSOR=

# Read in: lib/aztec/wallet/config.ts
NEXT_PUBLIC_AZTEC_SPONSORED_FPC=

# Read in: lib/aztec/wallet/ledger-sponsor.ts
NEXT_PUBLIC_AZTEC_SPONSOR_ADMIN=

# Private tokens the wallet lists. Must match deployments/aztec-mainnet.json (scripts/aztec/check-alpha-config.mjs).
# Read in: lib/aztec/wallet/config.ts
NEXT_PUBLIC_AZTEC_TOKENS=

# Read in: lib/aztec/value-mode.ts
NEXT_PUBLIC_AZTEC_VALUE_MODE=

# disabled | testnet | mainnet | demo. "demo" runs local simulations and is refused in production and on Alpha.
# Read in: lib/features/zk.ts
NEXT_PUBLIC_ZK_MODE=

