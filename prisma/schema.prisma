// 
// SOVEREIGN CRYPTOGRAPHIC AUDIT TRAIL
// Immutable HMAC-SHA256 chained event log for ENISA / eIDAS 2.0 compliance.
// Each entry's HMAC includes the previous entry's payloadHash (hash chain).
// Any deletion or modification of entries is cryptographically detectable.
// This table must have INSERT-ONLY permissions at the DB role level.
// Verification: lib/audit/audit-trail.ts  verifyAuditTrailIntegrity()
// 

model SystemAuditLog {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  // Event classification
  event       String // AuditEventType  see lib/audit/audit-trail.ts
  actor       String // Wallet address (0x...) or system identifier
  ip          String
  metadata    String   @db.Text // JSON-serialized, included in payloadHash
  // Cryptographic chain fields
  payloadHash String   @unique // SHA-256(timestamp+event+actor+ip+metadata)
  hmacSig     String // HMAC-SHA256(payloadHash:prevHash, AUDIT_SECRET)
  prevHash    String // payloadHash of the previous entry, or 'GENESIS'

  @@index([event, createdAt(sort: Desc)])
  @@index([actor, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("system_audit_log")
}

