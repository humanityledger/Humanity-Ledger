// schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // NOTE: pg_trgm/btree_gin/unaccent extensions omitted 
  // Railway PostgreSQL does not guarantee superuser extension access.
  // Full-text search is handled at the application layer via Prisma fullTextSearchPostgres.
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

// 
// TRI-LAYER KINETIC MATRICES & ARTICLES
// 

model Article {
  id          String   @id @default(uuid())
  title       String
  content     String   @db.Text
  sentiment   Float // AI Score 0-100 indicating sentiment
  bias        String // "Bullish", "Bearish", "Neutral"
  category    String // "Macro", "Regulation", "DeFi", "Hacks"
  publishedAt DateTime @default(now())
  sectorId    String?
  author      String

  sector Sector? @relation(fields: [sectorId], references: [id])

  //   INDEXACIÓN CÓSMICA: Articulación para texto completo e informes temporales
  @@index([category, publishedAt(sort: Desc)]) // Filtrado rápido por categoría + cronología
  @@index([bias, sentiment]) // Análisis de polaridad institucional
  @@index([sectorId, publishedAt(sort: Desc)]) // Drill-down por sector en dashboards
}

// 
// 103 MICRO-SECTORS ENGINE
// 

model Sector {
  id          String    @id @default(uuid())
  slug        String    @unique // e.g. "layer-1", "ai", "rwa", "yield-farming"
  name        String
  description String?   @db.Text
  totalTvl    Float     @default(0.0)
  volume24h   Float     @default(0.0)
  zScore      Float // Custom Ledger Rotation Score
  articles    Article[]

  //   INDEXACIÓN CÓSMICA: Rendimiento y ordenamiento dinámico
  @@index([zScore(sort: Desc)]) // Top Sectors by Ledger Rotation Score
  @@index([totalTvl(sort: Desc)]) // Ranking por TVL en tiempo real
}

// 
// SOVEREIGN AUTHORITY & COMMERCIAL ONTOLOGY
// 

model GoldRegistryAudit {
  id                String  @id @default(uuid())
  platformName      String
  slug              String  @unique
  type              String // "Casino", "Wallet", "Exchange", "PredictionMarket"
  isVerifiedOnChain Boolean @default(false)
  smartContractRef  String? // Contract validated by local/Polygon ping
  solvencyStatus    String // "Confirmed", "Suspicious", "Unknown"
  systemBridgeUrl   String // E.g., The dark-pool routed affiliate bridge

  // High-performance metrics tailored to CryptoSlate's taxonomies
  features        String[] // ["No KYC", "Instant Withdrawal", "Cold Storage"]
  supportedChains String[] // ["Ethereum", "Solana", "Base"]
}

// 
// ECOSYSTEM MAPPING
// 

model EcosystemWarRoomData {
  id            String @id @default(uuid())
  chainName     String @unique
  chainSymbol   String
  totalEntities Int    @default(0)
  tvl           Float  @default(0.0)
  volume24h     Float  @default(0.0)
}

// 
// SOVEREIGN USER PROFILES & WATCHLISTS
// 

model User {
  id                String   @id @default(uuid())
  walletAddress     String   @unique
  displayName       String?
  avatarUrl         String?  @db.Text
  bio               String?  @db.Text
  isPro             Boolean  @default(false)
  isZkVerified      Boolean  @default(false)
  tier              String   @default("FREE")
  lastActive        DateTime @default(now())
  goldTicketTokenId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  worldIdNullifierHash String? @unique

  //  General Settings 
  theme         String @default("light")
  currency      String @default("USD")
  language      String @default("en")
  timeFormat    String @default("24h") // "12h" | "24h"
  dateFormat    String @default("DD/MM/YYYY") // "DD/MM/YYYY" | "MM/DD/YYYY"
  addressFormat String @default("truncated") // "truncated" | "full"

  //  Display & Hardware 
  showBalances         Boolean  @default(true)
  hiddenAssets         String[] @default([])
  defaultTimeframe     String   @default("1W") // "1D", "1W", "1M", "ALL"
  displayUnit          String   @default("FIAT") // "FIAT", "BTC", "ETH"
  layoutDensity        String   @default("compact") // "relaxed" | "compact" | "dense"
  hardwareAcceleration Boolean  @default(true)

  //  Network & RPC 
  gasPreset     String  @default("STANDARD") // "ECONOMY" | "STANDARD" | "FAST" | "INSTANT"
  customRpcUrl  String?
  mevProtection Boolean @default(false)
  maxSlippage   Float   @default(0.5)
  testnetMode   Boolean @default(false)

  //  Privacy & Security 
  inactivityLockMinutes Int     @default(60)
  autoDisconnectTimer   String  @default("1h") // "15m" | "1h" | "24h" | "never"
  stealthMode           Boolean @default(false)
  requireSignForExports Boolean @default(true)
  allowAnalytics        Boolean @default(true)
  extendedSettings      Json?   @default("{}")

  //  Sonar Alerts 
  emailAlerts         Boolean @default(false)
  telegramAlerts      Boolean @default(false)
  ledgerAlertThreshold Float   @default(1000000)
  soundEffects        Boolean @default(true)

  //  Ledger Chat 
  chatName    String  @default("Ledger User")
  chatBio     String  @default("")
  qrLabel     String  @default("Scan My Wallet")
  chatPinHash String?

  // Enclave PIN (Turing Shield Gate) — HMAC-SHA256 hash, never plaintext
  enclavePinHash String?

  // Enclave PIN Reset — OTP fields (10-min TTL, max 5 verify attempts)
  enclaveOtpHash      String?
  enclaveOtpExpiresAt DateTime?
  enclaveOtpAttempts  Int       @default(0)

  // Enclave PIN Reset — Rate Limiting & Clearance Token
  otpSentCount          Int       @default(0)
  otpLastSentAt         DateTime?
  enclaveClearanceToken String?
  enclaveClearanceTs    DateTime?

  // Forum-specific settings
  isAdmin         Boolean @default(false)
  notifyOnReply   Boolean @default(true)
  notifyOnMention Boolean @default(true)

  clerkId              String? @unique
  email                String? @unique
  snxAccountId         String? @unique
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  watchlists       Watchlist[]
  alerts           Alert[]
  canvasState      CanvasState?
  progress         UserProgress[]
  submissions      AcademySubmission[]
  sentMessages     MentoringMessage[]  @relation("SentMessages")
  receivedMessages MentoringMessage[]  @relation("ReceivedMessages")

  // Forum Relations
  forumTopics        ForumTopic[]
  forumPosts         ForumPost[]
  forumLikes         ForumLike[]
  forumNotifications ForumNotification[]
  actorNotifications ForumNotification[] @relation("ActorNotifications")

  apiKeys           ApiKey[]
  watchedWallets    WatchedWallet[]
  exchangePositions ExchangePosition[]

  // System Credits & Humanity Ledger (Node V4.0)
  creditsBalance Int             @default(2500)
  humanityScore  Int             @default(0)
  creditLedgers  CreditLedger[]
  humanityEvents HumanityEvent[]
  notifications  Notification[]

  //   INDEXACIÓN CÓSMICA: Segmentación de usuarios para analytics y acceso a nivel Pro
  @@index([tier, lastActive(sort: Desc)]) // Consulta de usuarios activos por tier
  @@index([isPro, createdAt(sort: Desc)]) // Funnel de conversión Pro
  @@index([createdAt(sort: Desc)]) // Registro cronológico general
}

model CreditLedger {
  id          String   @id @default(uuid())
  userId      String
  amount      Int // Negative for usage, positive for top-up
  action      String // E.g., 'NEO4J_QUERY', 'Z_SCORE_THERMO'
  description String?
  timestamp   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp(sort: Desc)])
}

model HumanityEvent {
  id        String   @id @default(uuid())
  userId    String
  eventType String // E.g., 'EIP191_SIGNATURE', 'FORUM_POST'
  points    Int
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp(sort: Desc)])
}

model ApiKey {
  id        String   @id @default(uuid())
  key       String   @unique
  userId    String
  plan      String   @default("ledger")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [walletAddress], onDelete: Cascade)

  @@index([userId, isActive])
}

model AuthUser {
  id                  String    @id @default(uuid())
  email               String    @unique
  name                String?
  username            String?   @unique
  passwordHash        String?
  walletAddress       String?   @unique
  encryptedMnemonic   String?   @db.Text
  walletSalt          String?
  verified            Boolean   @default(false)
  verificationCode    String? // legacy inline code field (kept for compatibility)
  codeExpiresAt       DateTime?
  totpSecret          String?   @db.Text
  backupCodes         String[]  @default([])
  lastLoginAt         DateTime?
  recoveryEmail       String?
  encryptedPrivateKey String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Enclave PIN (Turing Shield Gate) — HMAC-SHA256 hash, never plaintext
  enclavePinHash String?

  // Enclave PIN Reset — OTP fields (10-min TTL, max 5 verify attempts)
  enclaveOtpHash      String?
  enclaveOtpExpiresAt DateTime?
  enclaveOtpAttempts  Int       @default(0)

  // Enclave PIN Reset — Rate Limiting & Clearance Token
  otpSentCount          Int       @default(0)
  otpLastSentAt         DateTime?
  enclaveClearanceToken String?
  enclaveClearanceTs    DateTime?

  securityEvents    SecurityEvent[]
  verificationCodes VerificationCode[]

  @@index([email])
  @@index([walletAddress])
  @@index([username])
}

model EmailSubscriber {
  id               String   @id @default(uuid())
  email            String   @unique
  frequency        String   @default("weekly") // "daily", "weekly", "monthly"
  subscribed       Boolean  @default(true)
  unsubscribeToken String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([subscribed])
  @@index([createdAt])
}

model WatchedWallet {
  id            String   @id @default(uuid())
  userId        String
  address       String   @default("") // Normalized: 0x... or bc1... or SOL pubkey
  label         String   @default("Anonymous Ledger")
  tags          String[] @default([])
  lastValue     Float    @default(0)
  change24h     Float    @default(0)
  pnl24h        Float    @default(0)
  txCount       Int      @default(0)
  riskScore     Float    @default(50)
  activityScore Float    @default(0)
  isLedger       Boolean  @default(false)
  isSmart       Boolean  @default(false)
  alertsEnabled Boolean  @default(false)
  metadata      Json? // Stats breakdown cache
  forensics     Json? // Forensic analysis result
  category      String? // Exchange|Ledger|MEV|Fund etc.
  identityTier  String? // LEGENDARY|ELITE|SOVEREIGN etc.
  lastCheck     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, address])
  @@index([userId, createdAt(sort: Desc)])
  @@index([address])
}

model AddressBookEntry {
  id         String   @id @default(uuid())
  authUserId String
  name       String
  address    String
  ensName    String?
  label      String?
  notes      String?  @db.Text
  isFavorite Boolean  @default(false)
  chainId    Int?     @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([authUserId, address])
  @@index([authUserId])
  @@index([address])
}

model ChatContact {
  id        String   @id @default(uuid())
  owner     String
  peer      String
  updatedAt DateTime @updatedAt

  @@unique([owner, peer])
  @@index([owner])
}

// Instagram-style friend request system
model ChatContactRequest {
  id          String   @id @default(uuid())
  fromAddress String   // wallet address of requester
  toAddress   String   // wallet address of recipient
  status      String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([fromAddress, toAddress])
  @@index([toAddress, status])
  @@index([fromAddress, status])
}

model PendingChatMessage {
  id        String   @id @default(uuid())
  sender    String
  recipient String
  content   String   @db.Text
  timestamp DateTime @default(now())

  @@index([recipient])
  @@index([sender])
}

model ExchangePosition {
  id            String   @id @default(uuid())
  userId        String
  exchange      String
  symbol        String
  size          Float
  entryPrice    Float
  markPrice     Float
  unrealizedPnl Float
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [walletAddress], onDelete: Cascade)

  @@index([userId, status])
}

// 
// NODE SUBSCRIPTIONS & STRIPE
// FIX: Missing Subscription model referenced by Stripe webhooks
// 
model Subscription {
  id        String   @id @default(uuid())
  userId    String   @unique // Maps to User.walletAddress typically
  status    String // 'ACTIVE', 'CANCELED', 'PAST_DUE'
  tier      String // 'LIFETIME_VIP', 'PRO_MONTHLY', etc.
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Watchlist {
  id      String   @id @default(uuid())
  userId  String
  symbol  String // E.g., "BTCUSDT" or a contract address
  chain   String   @default("multi")
  addedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol, chain])
}

model Alert {
  id         String   @id @default(uuid())
  userId     String
  targetType String // "PRICE", "GAS", "LEDGER_TX", "LIQUIDATION"
  condition  String // "ABOVE", "BELOW", "EQUALS"
  threshold  Float
  metric     String // e.g., "BTC", "ETH_GAS"
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CanvasState {
  id           String   @id @default(uuid())
  userId       String   @unique
  nodes        Json // Institutional Node Topography
  edges        Json // Connection Matrices
  pan          Json? // Navigation Coordinates
  lastSyncedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastSyncedAt(sort: Asc)])
}

// 
// SIWE AUTHENTICATION NONCES
// 

model SiweNonce {
  id        String   @id @default(uuid())
  nonce     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// 
// LEDGER CHAT — CALL ROOMS
// Ephemeral rooms for group video/audio calls with password protection.
// Auto-expire after 2h idle. Moderator can transfer control and kick participants.
// 

model CallRoom {
  id               String   @id @default(cuid())
  roomId           String   @unique // 8-char alphanumeric, user-visible
  passwordHash     String   // SHA-256 of password, never stored plaintext
  hostAddress      String   // Wallet address of room creator
  moderatorAddress String   // Current moderator (starts as host, can be transferred)
  isVideo          Boolean  @default(true)
  maxParticipants  Int      @default(20)
  participants     String[] // Array of wallet addresses currently in room
  createdAt        DateTime @default(now())
  lastActivityAt   DateTime @default(now())
  expiresAt        DateTime // createdAt + 2h, enforced server-side
  isActive         Boolean  @default(true)

  @@index([roomId])
  @@index([hostAddress])
  @@index([expiresAt])
}

// 
// CALL ROOM JOIN TOKENS
// Signed tokens issued on successful password validation. Expire in 30min.
// Prevents replay attacks and unauthorized joins after token expiry.
// 

model CallRoomToken {
  id          String   @id @default(cuid())
  roomId      String
  address     String
  token       String   @unique // HMAC-signed, single-use
  used        Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([roomId, address])
  @@index([token])
}



// 
// CANONICAL IDENTITY (P2 SIWE MIGRATION)
// 

model HumanityIdentity {
  id                 String    @id @default(uuid())
  walletAddress      String    @unique
  chainId            Int
  walletType         String    @default("EOA") // EOA, SMART_ACCOUNT, MULTISIG
  verificationStatus String    @default("UNVERIFIED") // UNVERIFIED, SIWE_VERIFIED, ZK_VERIFIED
  createdAt          DateTime  @default(now())
  lastVerifiedAt     DateTime?
  
  permissions        String[]  @default([]) // e.g. "registry:write", "admin:all"
  
  sessions           HumanitySession[]
}

model HumanitySession {
  sessionId            String   @id @default(uuid())
  identityId           String
  authenticationMethod String   // "SIWE", "LEGACY_ADAPTER"
  createdAt            DateTime @default(now())
  expiresAt            DateTime
  revokedAt            DateTime?
  lastSeenAt           DateTime @default(now())
  securityContext      Json?    // { ip: "...", userAgent: "..." }
  version              Int      @default(1)

  identity HumanityIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([expiresAt])
}

// 
// ON-CHAIN ACADEMY PROGRESSION
// 

model Course {
  id            String   @id @default(uuid())
  slug          String   @unique
  title         String
  description   String   @db.Text
  totalDuration String
  badge         String?
  level         String   @default("Beginner")
  lessons       Lesson[]
}

model Lesson {
  id          String  @id @default(uuid())
  courseId    String
  title       String
  duration    String
  level       String
  description String  @db.Text
  orderIndex  Int
  isLocked    Boolean @default(false)

  course      Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    UserProgress[]
  submissions AcademySubmission[]
}

model UserProgress {
  id        String   @id @default(uuid())
  userId    String
  lessonId  String
  completed Boolean  @default(true)
  timestamp DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

// 
// ACADEMY MENTORING & TEACHER VALIDATIONS (MAXIMUM LMS)
// 

model AcademySubmission {
  id          String   @id @default(uuid())
  userId      String
  lessonId    String
  contentUrl  String?
  txHash      String?
  status      String   @default("PENDING") // PENDING, PASSED, FAILED
  feedback    String?  @db.Text
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
  @@index([status])
}

model MentoringMessage {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String   @db.Text
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, read])
}

// 
// GOLDEN TICKET CLAIM
// 

model GoldenTicket {
  id                    String   @id @default(uuid())
  userAddress           String   @unique
  serialCode            String   @unique
  tier                  String   @default("GENESIS")
  badgeColor            String   @default("GOLD")
  networkLaunchEligible Boolean  @default(true)
  ticketNumber          Int      @default(autoincrement())
  twitterHandle         String?
  signatureData         String?  @db.Text
  isActive              Boolean  @default(true)
  claimedAt             DateTime @default(now())
  updatedAt             DateTime @default(now()) @updatedAt

  // Compound indexes for dashboard query patterns:
  // /api/golden-ticket GET: WHERE isActive=true ORDER BY claimedAt DESC TAKE 30
  // /api/akashic hash verification: WHERE userAddress
  @@index([isActive, claimedAt(sort: Desc)])
  @@index([tier, claimedAt(sort: Desc)])
  @@index([ticketNumber])
}

// 
// SOVEREIGN INTELLIGENCE CORPUS (ARKHAM/NANSEN KILLER)
// 

model IntelItem {
  id          String   @id @default(uuid())
  url         String   @unique
  title       String
  source      String
  aiSummary   String?  @db.Text
  category    String   @default("FINANCE")
  priority    String   @default("SOVEREIGN")
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([publishedAt(sort: Desc)])
  @@index([category, publishedAt(sort: Desc)])
}

model NewsArticle {
  id          String   @id @default(uuid())
  externalId  String?  @unique
  title       String
  summary     String   @db.Text
  url         String   @unique
  source      String
  imageUrl    String?
  category    String   @default("crypto")
  publishedAt DateTime @default(now())

  // Forensic Analysis
  veracityScore    Int     @default(0)
  veracityAnalysis String? @db.Text
  isFake           Boolean @default(false)
  sentiment        String  @default("neutral") // bullish, bearish, neutral

  tokens String[] @default([]) // Referenced in UI

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publishedAt(sort: Desc)])
  @@index([source])
}

model OnChainEntity {
  id             String   @id @default(uuid())
  address        String   @unique
  label          String? // The identity of the entity
  category       String? // Exchange, Ledger, MEV, Fund
  isZkShielded   Boolean  @default(false)
  neo4jNodeId    String?  @unique // Reference to local graph DB node
  totalVolumeUSD Float    @default(0.0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastActive     DateTime @default(now())

  labels EntityLabel[]
}

model EntityLabel {
  id              String   @id @default(uuid())
  entityId        String
  labelName       String
  confidenceScore Float    @default(1.0)
  source          String // "NeuralAgent", "UserDefined", "TeranodeStream"
  createdAt       DateTime @default(now())

  entity OnChainEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
}

model NeuralAgentConfig {
  id                 String   @id @default(uuid())
  agentId            String   @unique
  mode               String   @default("OBSERVER") // OBSERVER, EXECUTION, HFT
  maxSlippage        Float    @default(0.5)
  targetChains       String[] // E.g., ["Ethereum", "Solana", "EVM"]
  isActive           Boolean  @default(true)
  autoTradeThreshold Float?
  lastPingAt         DateTime @default(now())
}

// 
// SOBERANIA DE CUSTODIA (ON-CHAIN CONTRACT STATES)
// 

model TimeLockVault {
  id          String   @id @default(uuid())
  userAddress String   @unique
  amount      Float
  unlockDate  DateTime
  txHash      String?
  status      String   @default("LOCKED") // "LOCKED", "WITHDRAWN"
  createdAt   DateTime @default(now())
}

model DeadMansSwitch {
  id               String   @id @default(uuid())
  userAddress      String   @unique
  beneficiary      String
  inactivityPeriod Int // En segundos
  lastPing         DateTime @default(now())
  active           Boolean  @default(true)
  txHash           String?
}

model Guardian {
  id              String  @id @default(uuid())
  userEmail       String
  guardianAddress String
  threshold       Int     @default(3) // Firmas requeridas
  isActive        Boolean @default(true)

  @@unique([userEmail, guardianAddress])
}

model PrivacyDonation {
  id         String   @id @default(uuid())
  amount     Float
  nullifier  String   @unique
  commitment String   @unique
  timestamp  DateTime @default(now())
}

// 
// LEDGER TELEMETRY & ACTIVITY
// 

model LedgerActivity {
  id              String   @id @default(uuid())
  immutableId     String?  @unique(map: "sov_ledger_identity_idx_v3") // Reconciliación institucional de índice
  walletAddress   String? // Opcional para BTC (usar toAddress)
  type            String   @default("TRANSFER") // 'TRANSFER', 'SWAP', 'MINT', 'BURN'
  token           String   @default("BTC")
  amount          String   @default("0")
  usdValue        String   @default("0")
  valueBTC        Float    @default(0) // Valor real en satoshis/btc
  btcPriceAtTx    Float    @default(0) // Precio histórico capturado
  fromAddress     String
  toAddress       String
  transactionHash String   @unique
  blockNumber     BigInt?
  blockHeight     Int? // Altura del bloque BTC
  chain           String   @default("BTC")
  entityName      String   @default("Unknown") // MicroStrategy, BlackRock, etc.
  institutional   Boolean  @default(false)
  confirmed       Boolean  @default(true)
  metadata        Json?
  timestamp       DateTime @default(now())
  isZkVerified    Boolean  @default(false)

