// 
model SocialVerification {
  id             String   @id @default(uuid())
  walletAddress  String   @unique
  twitterId      String?
  twitterFollow  Boolean  @default(false)
  youtubeId      String?
  youtubeFollow  Boolean  @default(false)
  telegramId     String?
  telegramFollow Boolean  @default(false)
  lastVerifiedAt DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([walletAddress])
}

// 
// AIRDROP CALENDAR 2100 & ANTI-SYBIL
// 
model AirdropClaim {
  id            String   @id @default(uuid())
  walletAddress String
  year          Int
  month         Int
  amount        Float    @default(10.0)
  txHash        String?  @unique
  claimedAt     DateTime @default(now())

  // Ensure one claim per wallet per month/year
  @@unique([walletAddress, year, month])
  @@index([walletAddress])
}

model ModerationReport {
  id              String   @id @default(uuid())
  reporterAddress String
  messageHash     String
  timestamp       DateTime @default(now())
  status          String   @default("PENDING")
}
