{
  "appId": "com.humanityledger.ledgerchat",
  "productName": "Ledger Chat",
  "copyright": "Copyright © 2026 Humanity Ledger",
  "artifactName": "${productName}-Setup-${version}.${ext}",
  "directories": {
    "output": "D:\\proyectofinalizado",
