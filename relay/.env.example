# Ledger Relay configuration. Every capability is off until its values are set; GET /v0/info says
# what this relay offers. Never commit the filled-in .env.

RELAY_NAME=Ledger Relay
# Who runs this relay, shown in /v0/info (a company, a community).
RELAY_OPERATOR=
# Browser origins allowed to call the relay.
RELAY_ALLOWED_ORIGINS=https://ledgerchat.org
# Leave empty for open access within rate limits; or list bearer tokens (comma separated) to limit
# TURN, uploads and push registration to your organisation's clients.
RELAY_ACCESS_TOKENS=
# Set to 1 only behind a reverse proxy you run, so rate limits see the client address.
RELAY_TRUST_PROXY=0

# TURN (calls across strict networks): the same secret as coturn's static-auth-secret.
RELAY_TURN_SECRET=
RELAY_TURN_REALM=relay.example.org
RELAY_TURN_URLS=turn:relay.example.org:3478?transport=udp,turn:relay.example.org:3478?transport=tcp,turns:relay.example.org:5349?transport=tcp
RELAY_TURN_TTL=3600

# Signalling (PeerJS compatible). Clients use path /peerjs/ and this key.
RELAY_SIGNALLING=1
RELAY_PEER_KEY=peerjs

# Encrypted files: ciphertext only, deleted on expiry.
RELAY_BLOB_MAX_BYTES=26214400
RELAY_BLOB_TTL=86400
RELAY_BLOB_MAX_TTL=604800
RELAY_BLOB_QUOTA_BYTES=5368709120

# Notifications: a VAPID key pair (base64url). Generate it on your machine, for example with
# `npx web-push generate-vapid-keys`; keep the private key out of the repository.
RELAY_VAPID_PUBLIC_KEY=
RELAY_VAPID_PRIVATE_KEY=
RELAY_VAPID_SUBJECT=https://relay.example.org

# Optional: a bearer token for GET /metrics (counters only).
RELAY_METRICS_TOKEN=
