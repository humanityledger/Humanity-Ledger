{
  "apps": [
    {
      "name": "humanity-ledger",
      "script": "node_modules/.bin/next",
      "args": "start -p ${PORT:-3000} -H 0.0.0.0",
      "instances": 1,
      "exec_mode": "fork",
      "autorestart": true,
      "watch": false,
      "max_memory_restart": "1G",
      "env": {
        "NODE_ENV": "production",
        "PORT": "3000"
      },
      "error_file": "/dev/stderr",
      "out_file": "/dev/stdout",
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z"
    }
  ]
}
