  "scripts": {
    "dev": "next dev",
    "score": "python docs/antigravity/score.py docs/antigravity/backlog.csv",
    "check:patterns": "node scripts/forbidden-patterns.mjs",
    "check:routes": "npx tsx scripts/route-inventory.ts",
    "push:railway": "git add . && git commit -m \"perf: institutional forum hardening, wave removal, profile fix\" && git push origin main",
    "db:sync": "npx prisma migrate deploy",
    "build": "prisma generate && cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" next build",
    "build:local": "echo 'LOCAL_BUILD' && prisma generate --no-engine && cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" next build",
    "build:ipfs": "cross-env IPFS_BUILD=true next build",
    "build:railway": "npx tailwindcss -i ./app/globals.css -o ./app/globals-compiled.css && prisma generate && npx prisma migrate deploy && cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" next build",
    "build:contracts": "npx hardhat compile",
    "deploy:deadman": "npx hardhat run scripts/deploy-deadman-switch.js --network polygonAmoy",
    "deploy:deadman:mainnet": "npx hardhat run scripts/deploy-deadman-switch.js --network polygon",
    "start": "npx prisma migrate deploy && next start",
    "start:prod": "npx prisma generate && npx prisma migrate deploy && cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" PRISMA_HIDE_UPDATE_MESSAGE=\"true\" npx next start -p ${PORT:-3000} -H 0.0.0.0",
    "start:all": "npx prisma migrate deploy && pm2-runtime start ecosystem.config.json",
    "compile:testnet": "node scripts/compile-testnet.js",
    "test": "vitest watch",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:crypto": "vitest run test/unit/crypto",
    "test:audit": "vitest run test/unit/audit",
    "test:resilience": "vitest run test/unit/resilience",
    "test:scan": "vitest run test/unit/scan",
    "lint": "next lint",
    "check:copy": "node scripts/check-forbidden-copy.mjs",
    "audit": "slither . --print human-summary",
    "audit:prepare": "slither . --print human-summary --exclude-dependencies --solc-remaps \"@openzeppelin=node_modules/@openzeppelin\"",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "migrate:status": "prisma migrate status",
    "check-migration": "ts-node scripts/check-migration-status.ts",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "ledger:start": "pm2 start ecosystem.config.json",
    "ledger:stop": "pm2 stop ledger-monitor",
    "ledger:restart": "pm2 restart ledger-monitor",
    "ledger:logs": "pm2 logs ledger-monitor",
    "ledger:status": "pm2 status ledger-monitor",
    "ledger:keepalive": "bash scripts/keep-ledger-alive.sh",
    "deploy:system": "npx hardhat run scripts/deploy-system.ts --network base",
    "deploy:system:testnet": "npx hardhat run scripts/deploy-system.ts --network baseGoerli",
    "deploy:system:local": "npx hardhat run scripts/deploy-system.ts --network localhost",
    "test:contracts": "npx hardhat test --network hardhat",
    "test:deadman": "npx hardhat test test/LedgerDeadmanSwitch.test.ts --network hardhat",
    "test:timelock": "npx hardhat test test/HumanTimeLock.test.ts --network hardhat",
    "test:gas": "REPORT_GAS=true npx hardhat test --network hardhat",
    "k8s:apply": "kubectl apply -f k8s/",
    "k8s:delete": "kubectl delete -f k8s/",
    "k8s:status": "kubectl get all -n ledger-alert",
    "helm:install": "helm install ledger-alert k8s/helm --namespace ledger-alert --create-namespace",
    "helm:upgrade": "helm upgrade ledger-alert k8s/helm --namespace ledger-alert --reuse-values",
    "helm:uninstall": "helm uninstall ledger-alert --namespace ledger-alert",
    "prepare": "node -e \"process.exit(0)\"",
    "postinstall": "node -e \"process.exit(0)\"",
    "aztec:setup": "node --conditions=browser --import ./scripts/aztec/register.mjs scripts/aztec/setup-testnet.mjs",
    "aztec:e2e": "node --conditions=browser --import ./scripts/aztec/register.mjs scripts/aztec/e2e-testnet.mjs"
  },
