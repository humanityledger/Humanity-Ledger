# Humanity Ledger — Aztec sequencer configuration (v6.0.0)
# Copy to .env and fill in. Never commit the filled file.
# Variable names and meanings follow docs.aztec.network ("Running a Sequencer").

# ── Network ─────────────────────────────────────────────────────────────────
# mainnet (Ethereum, rollup version 2070860440) or testnet (Sepolia, 679261766).
# Start on testnet; move to mainnet once the node has run cleanly for days.
AZTEC_NETWORK=testnet

# ── Paths on the host ───────────────────────────────────────────────────────
# Use a NEW, empty data directory for v6 (do not reuse a v5 one).
DATA_DIRECTORY=./data
# Holds keystore.json only. Never put keyN_staker_output.json files here:
# the node refuses to start if it finds them.
KEY_STORE_DIRECTORY=./keys

LOG_LEVEL=info

# ── Ethereum L1 ─────────────────────────────────────────────────────────────
# Execution endpoints, comma-separated for failover (mainnet: chain 1, testnet: Sepolia).
ETHEREUM_HOSTS=https://your-execution-endpoint
# Consensus (beacon) endpoints, comma-separated.
L1_CONSENSUS_HOST_URLS=https://your-beacon-endpoint
# An execution endpoint that serves debug_traceTransaction or trace_transaction.
# Required in v6: without it the node stalls on the first checkpoint it can't read.
# Falls back to ETHEREUM_HOSTS when empty.
ETHEREUM_DEBUG_HOSTS=https://your-trace-capable-endpoint

# ── Networking ──────────────────────────────────────────────────────────────
# Your public IPv4 (curl ipv4.icanhazip.com). TCP and UDP 40400 must be open.
P2P_IP=203.0.113.10
P2P_PORT=40400
# Node API. Keep it firewalled; the Humanity Ledger app reaches it privately.
AZTEC_PORT=8080
# Admin API: inside the container only, never published.
AZTEC_ADMIN_PORT=8880

# ── Monitoring (docker compose --profile monitoring up -d) ──────────────────
# Leave empty to disable metric export.
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel-collector:4318/v1/metrics
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password

# ── Humanity Ledger app (read-only dashboard at /sequencer) ─────────────────
# Set these on the Next.js server, not in the node container.
#   AZTEC_NETWORK=testnet
#   AZTEC_NODE_URL=http://<private-ip>:8080
#   AZTEC_L1_RPC_URL=https://your-execution-endpoint
#   AZTEC_ATTESTER_ADDRESSES=0xAttester1,0xAttester2
#   AZTEC_PUBLISHER_ADDRESSES=0xPublisher1           # defaults to the attesters
#   AZTEC_COINBASE_ADDRESS=0xRewardsAddress          # defaults to the first attester
