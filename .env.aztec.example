# .env.aztec.example — public configuration of the Aztec private wallet and ZK checks.
# Nothing here is a secret: real secrets (database, auth, API keys) go in your
# deployment's secret store, never in this file or in git.
#
# Canonical network values (L1 chain, rollup, node version) are in
# lib/aztec/sequencer/networks.ts. Check a node against them with
#   npm run aztec:health

# Aztec TEST network node (the wallet refuses a node that settles on mainnet).
NEXT_PUBLIC_AZTEC_NODE_URL=https://aztec-testnet.drpc.org
NEXT_PUBLIC_AZTEC_L1_CHAIN_ID=11155111
NEXT_PUBLIC_AZTEC_RPC_MAX_BATCH=3

# Written by `npm run aztec:setup` (scripts/aztec/setup-testnet.mjs).
NEXT_PUBLIC_AZTEC_SPONSORED_FPC=
NEXT_PUBLIC_AZTEC_TOKENS=
NEXT_PUBLIC_AZTEC_FAUCET=

# On-chain VK registry (contracts/ZKVerificationKeyRegistry.sol). Not deployed
# yet; while empty, assertVKIntegrityOnChain() throws instead of passing.
ZK_VK_REGISTRY_ADDRESS=
ZK_VK_REGISTRY_RPC_URL=

# docker-compose.yml / docker/docker-compose.yml (local development only).
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
